# ── Dónde se guarda todo ─────────────────────────────────────────
# En Railway, montá el volumen acá. Adentro se crean la base y las fotos.
DATA_DIR=/data

PORT=8080

# ── Administrador ────────────────────────────────────────────────
# Se entra por la misma puerta que los clientes: el servidor mira el email y
# decide el rol. Sin ADMIN_PASSWORD el panel no abre — no hay valor por
# defecto a propósito, porque un default conocido es una puerta abierta con la
# llave puesta.
ADMIN_EMAIL=ruthtintaya9@gmail.com
ADMIN_PASSWORD=

# ── A dónde llega cada pedido ────────────────────────────────────
PEDIDOS_EMAIL=isu.isuwaya@gmail.com
PEDIDOS_WHATSAPP=+5491169221390

# ── Envío de correo ──────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=ISUWAYA Mayorista <isu.isuwaya@gmail.com>

# ── WhatsApp (opcional) ──────────────────────────────────────────
# Meta Cloud API. Fuera de la ventana de 24 h hace falta plantilla aprobada.
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es_AR
