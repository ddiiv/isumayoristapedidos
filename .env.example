# ── Dónde se guarda todo ─────────────────────────────────────────
# En Railway NO hace falta: si el servicio tiene un volumen, la app lo detecta
# sola. Ponela sólo para usar otra carpeta, o en tu máquina.
# DATA_DIR=./datos

# ── Puerto ───────────────────────────────────────────────────────
# En Railway NO la cargues: la pone Railway y el dominio apunta a ese puerto.
# Si pegás acá un PORT distinto, el sitio contesta "Application failed to
# respond" con la app andando.
# PORT=8090

# ── Administrador ────────────────────────────────────────────────
# Se entra por la misma puerta que los clientes: el servidor mira el email y
# decide el rol. Sin ADMIN_PASSWORD el panel no abre — no hay valor por
# defecto a propósito, porque un default conocido es una puerta abierta con la
# llave puesta.
ADMIN_EMAIL=ruthtintaya9@gmail.com
ADMIN_PASSWORD=

# ── Firma de las sesiones ────────────────────────────────────────
# Opcional. Si no la ponés, el servidor se genera una sola vez y la guarda en
# la base, que en Railway vive en el volumen: sobrevive a los reinicios y a los
# deploys, así que no hay nada que hacer.
#
# Va aparte de ADMIN_PASSWORD a propósito. Cuando salía de la contraseña,
# cambiarla dejaba afuera a todos los clientes con sesión abierta y rompía los
# enlaces de descarga ya entregados; y al revés, quien conociera la contraseña
# podía además falsificar la sesión de cualquiera.
SESSION_SECRET=

# ── A dónde llega cada pedido ────────────────────────────────────
PEDIDOS_EMAIL=isu.isuwaya@gmail.com
PEDIDOS_WHATSAPP=+5491169221390

# ── Envío de correo ──────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=ISUWAYA Mayorista <isu.isuwaya@gmail.com>

# ── WhatsApp (opcional) ──────────────────────────────────────────
# Meta Cloud API. Fuera de la ventana de 24 h hace falta plantilla aprobada.
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es_AR

# ── STOCKER ────────────────────────────────────────────────────────
# A dónde se le mandan los pedidos para que aparte y descuente el stock.
# Sin las tres primeras la integración queda apagada: el portal funciona igual,
# pero el stock hay que descontarlo a mano. Detalle en INTEGRACION-STOCKER.md.
#
# Mismo proyecto de Railway (recomendado, el backend no se expone):
#   STOCKER_URL=http://backend.railway.internal:8080
# Proyectos distintos, por el proxy /api del frontend público:
#   STOCKER_URL=https://app.eldominio.com/api
STOCKER_URL=
STOCKER_TOKEN=
STOCKER_NEGOCIO=
# Opcionales: la ruta, cada cuánto sale la cola y cuánto espera cada llamada.
#STOCKER_RUTA=/integraciones/isuwaya/pedidos
#STOCKER_CADA_MS=20000
#STOCKER_TIMEOUT_MS=15000
